// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  email      String?
  role       String?  @default("admin")
  created_at DateTime @default(now())

  @@map("admin_users")
}

model Product {
  id               Int      @id @default(autoincrement())
  name             String
  description      String
  material         String
  rise             String
  price            Float
  category         String?
  compare_at_price Float?
  transfer_price   Float?
  images           Json? // Assuming JSON string for images
  video            String?
  stock            Int      @default(0)
  colors           Json? // Assuming JSON string for colors
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  reviews          Review[]

  @@map("products")
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  description String?
  image       String?
  is_active   Boolean @default(true)
  sort_order  Int     @default(0)

  @@map("categories")
}

model Order {
  id                       String    @id
  customer_id              String
  customer_name            String
  customer_email           String
  customer_phone           String?
  customer_doc_number      String?
  items                    Json // Assuming JSON string for items
  total                    Int
  status                   String?   @default("pending")
  shipping_street_name     String?
  shipping_street_number   String?
  shipping_apartment       String?
  shipping_description     String?
  shipping_city            String?
  shipping_postal_code     String?
  shipping_province        String?
  shipping_cost            Int?
  shipping_name            String?
  shipping_details         String?
  payment_method           String?
  created_at               DateTime  @default(now())
  customer                 Customer @relation(fields: [customer_id], references: [id])

  @@map("orders")
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  phone       String?
  order_count Int      @default(0)
  total_spent Int      @default(0)
  created_at  DateTime @default(now())
  orders      Order[]

  @@map("customers")
}

model SiteSetting {
  key   String  @id
  value String?

  @@map("site_settings")
}

model DropNotification {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  phone      String?
  created_at DateTime @default(now())

  @@map("drop_notifications")
}

model AnalyticsEvent {
  id         Int      @id @default(autoincrement())
  event_name String
  event_data Json? // Assuming JSON string
  created_at DateTime @default(now())

  @@map("analytics_events")
}

model Review {
  id          Int      @id @default(autoincrement())
  product_id  Int
  title       String
  rating      Int
  comment     String
  user_name   String
  user_email  String
  is_approved Boolean  @default(false)
  created_at  DateTime @default(now())
  product     Product  @relation(fields: [product_id], references: [id])

  @@map("reviews")
}

model AbandonedCart {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  cart_items Json
  status     String   @default("pending")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("abandoned_carts")
}
